	<string>953351033382-vfgtti9tju6taiq2umdh0l7bqnn931kr.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.953351033382-vfgtti9tju6taiq2umdh0l7bqnn931kr</string>
			</array>
		</dict>
	</array>
	<!-- 標準の暗号化（HTTPS）だけを使うので、輸出規制の申告は不要 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- ファイル選択の部品が写真ライブラリの機能を含むため、説明文が必要 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>X のアーカイブなどのファイルを選ぶときに使います。</string>
	<!-- アプリが対応している言語（App Store の表示と、端末の言語に合わせた表示に必要） -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
	</array>
	<!-- Face ID でのロック（設定でオンにした人だけ使う） -->
	<key>NSFaceIDUsageDescription</key>
	<string>カレンさんのロックを解除するために Face ID を使います。</string>
